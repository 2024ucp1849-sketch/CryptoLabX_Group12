# MAIN PROGRAM
# ------------------------------------------------------------
def main():

    print("==============================================")
    print(" VIGENERE CIPHER CRYPTANALYSIS")
    print(" KASISKI + FREQUENCY ANALYSIS")
    print("==============================================")

    ciphertext = input("\nEnter ciphertext: ")

    # Step 1
    ciphertext = clean_ciphertext(ciphertext)

    print("\nCleaned Ciphertext:")
    print(ciphertext)

    # Step 2
    candidates = kasiski_analysis(ciphertext)

    if not candidates:
        print("\nCould not estimate key length using Kasiski.")
        return    # Select most probable key length
    key_length = candidates[0]

    print("\n==============================================")
    print("Estimated Key Length:", key_length)
    print("==============================================")

    # Step 3
    groups = split_into_groups(ciphertext, key_length)

    print("\n========== GROUPS ==========")

    for i, group in enumerate(groups):
        print("Group", i + 1, ":", group)

    # Step 4
    print("\n========== FREQUENCY TABLES ==========")

    for i, group in enumerate(groups):

        frequency = frequency_analysis(group)

        print("\nGroup", i + 1)
        print("----------------------")

        for letter, count in frequency.items():
            print(letter, ":", count)

        print("IC =", calculate_ic(group))

    # Step 5
    key, shifts = find_key(groups)

    print("\n==============================================")
    print("RECOVERED KEY")
    print("==============================================")

    print("Key:", key)

    print("\nShifts:")

    for i, shift in enumerate(shifts):
        print(
            "Group",
            i + 1,
            "-> Shift",
            shift,
            "->",
            chr(shift + ord('A'))
        )

    # Step 6
    plaintext = vigenere_decrypt(ciphertext, key)

    print("\n==============================================")
    print("RECOVERED PLAINTEXT")
    print("==============================================")

    print(plaintext)

    # Step 7
    verify(ciphertext, plaintext, key)


